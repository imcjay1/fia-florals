---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-cream.png';
import { business, socials } from '../data/site';
import Newsletter from './Newsletter.astro';
const year = new Date().getFullYear();
---
<footer class="dark site-footer">
  <div class="wrap">
    <Newsletter />
    <div class="cols">
      <div class="col about">
        <Image src={logo} alt="Fia Florals" width={180} />
        <p class="body">Bespoke flowers and floristry workshops, handmade in {business.city}.</p>
      </div>
      <nav aria-label="Shop" class="col">
        <span class="h">Shop</span>
        <a href="/shop/hand-tied-bouquet">Bouquets</a>
        <a href="/shop/vase-arrangement">Vase arrangements</a>
        <a href="/shop/flower-subscription">Subscriptions</a>
        <a href="/shop/gift-voucher">Gift vouchers</a>
        <a href="/workshops">Workshop tickets</a>
      </nav>
      <nav aria-label="Flowers for" class="col">
        <span class="h">Flowers for</span>
        <a href="/weddings">Weddings</a>
        <a href="/funeral-flowers">Funerals</a>
        <a href="/events-business">Events &amp; business</a>
        <a href="/workshops#private">Private workshops</a>
        <a href="/christmas-wreaths">Christmas wreaths</a>
      </nav>
      <div class="col">
        <span class="h">Say hello</span>
        <a href={`tel:${business.phoneIntl}`}>{business.phone}</a>
        <a href={`mailto:${business.email}`}>{business.email}</a>
        <a href={business.whatsapp}>WhatsApp</a>
        <div class="social">
          {socials.map((s) => (
            <a href={s.url} aria-label={`${s.name} ${s.handle}`} rel="me noopener" target="_blank">
              {s.name === 'Instagram' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>}
              {s.name === 'Facebook' && <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-2.8 0-4 1.8-4 4.5V11H7v4h3v7h4v-7h3l1-4h-4V8.8c0-.5.3-.8 1-.8z" /></svg>}
              {s.name === 'TikTok' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.5 2.8 2.3 4.5 5 4.8" /></svg>}
              {s.name === 'Threads' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M16.5 11.2c-.3-2.6-1.9-3.9-4.3-3.9-2 0-3.4 1-3.9 2.6M8.5 14.5c.3 1.5 1.6 2.4 3.3 2.4 2.3 0 3.6-1.5 3.6-3.6 0-1.5-1.1-2.6-3.4-2.6-1.9 0-3.1.8-3.1 2.1M12 21c5 0 8-3.2 8-9s-3-9-8-9-8 3.2-8 9 3 9 8 9z" /></svg>}
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="legal">
      <span>© {year} Fia Florals</span>
      <div class="links">
        <a href="/delivery-faqs">Delivery &amp; FAQs</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <span>Payments secured by Stripe</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: 72px 36px; color: var(--plum-soft); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 40px; margin-top: 64px; }
  .col { display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .about { gap: 16px; }
  .about :global(img) { width: 180px; height: auto; }
  .h { font-weight: 700; color: var(--petal); letter-spacing: 0.08em; text-transform: uppercase; font-size: 13px; margin-bottom: 4px; }
  .col a { color: var(--plum-soft); text-decoration: none; }
  .col a:hover { color: var(--petal); text-decoration: underline; }
  .social { display: flex; gap: 10px; padding-top: 8px; }
  .social a { width: 44px; height: 44px; border-radius: 50%; background: var(--petal); color: var(--plum); display: inline-flex; align-items: center; justify-content: center; }
  .social a:hover { background: var(--pink-on-plum); color: var(--plum); text-decoration: none; }
  .legal { border-top: 1px solid rgba(250, 243, 238, 0.18); margin-top: 48px; padding-top: 24px; display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; font-size: 14px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .legal a { color: var(--plum-soft); }
</style>
