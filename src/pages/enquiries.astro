---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { business } from '../data/site';
import photo from '../assets/photos/two-bouquets.jpg';
---
<Base
  title="Enquiries — got an idea? | Fia Florals, Manchester"
  description="Got an idea that doesn't fit a box? Collaborations, venue partnerships, photoshoots, shop windows, one-off pieces — tell Sophia at Fia Florals what you have in mind."
  image={photo}
>
  <section class="wrap page-hero">
    <nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Enquiries</span></nav>
    <div class="split" style="align-items:start">
      <div class="stack">
        <span class="eyebrow">Enquiries</span>
        <h1 class="disp h1" style="font-size:clamp(44px,5.6vw,80px)">Got an idea? <em>Tell me.</em></h1>
        <p class="lead">Not everything fits on a menu. If you've got something in mind, a collaboration, a shop window, a photoshoot, a venue partnership or a one-off piece, send me the details and I'll come back to you.</p>
        <div class="pills"><span class="pill sage">Collaborations</span><span class="pill coral">Venue partnerships</span><span class="pill mint">Photoshoots</span><span class="pill">Shop windows</span><span class="pill">One-off pieces</span></div>
        <p class="body">Looking for something specific? <a href="/weddings">Weddings</a> · <a href="/funeral-flowers">Funeral flowers</a> · <a href="/events-business">Events &amp; business</a> · <a href="/hen-party-workshops">Hen parties</a> · <a href="/workshops#private">Private workshops</a></p>
        <div class="rounded" style="aspect-ratio:4/3"><Image src={photo} alt="Two bespoke Fia Florals bouquets" widths={[480, 800]} sizes="(max-width:900px) 100vw, 560px" class="cover" loading="eager" /></div>
        <p class="small">Rather talk? Call or WhatsApp <a href={`tel:${business.phoneIntl}`}>{business.phone}</a>.</p>
      </div>
      <EnquiryForm
        id="general-enquiry"
        subject="New idea / general enquiry"
        white
        submit="Send my idea"
        fields={[
          { name: 'organisation', label: 'Business or organisation', hint: 'if any' },
          { name: 'type', label: 'What is it?', type: 'select', options: ['Collaboration', 'Venue partnership', 'Photoshoot or styling', 'Shop window or display', 'A one-off piece', 'Something else'] },
          { name: 'date', label: 'Date (if there is one)', type: 'date' },
          { name: 'budget', label: 'Budget', placeholder: '£' },
          { name: 'message', label: 'Tell me your idea', type: 'textarea', required: true },
        ]}
      />
    </div>
  </section>
</Base>
