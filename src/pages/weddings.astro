---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { bookedWeddingDates } from '../data/content';
import buttonholes from '../assets/photos/wedding-buttonholes.jpg';
import peony from '../assets/photos/sophia-peony.jpg';
import cream from '../assets/photos/sophia-bouquet-cream.jpg';
import wild from '../assets/photos/wild-bouquet.jpg';

const faq = [
  { q: 'What wedding flowers do you make?', a: 'Bridal and bridesmaid bouquets, buttonholes and corsages, table flowers, ceremony pieces and anything else your day needs.' },
  { q: 'How do I book?', a: 'Check your date above, then send the enquiry form. I come back to you to talk through your ideas, colours and venue before anything is confirmed.' },
  { q: 'Which months do you take weddings?', a: 'All year round — spring, summer, autumn and winter weddings are all welcome.' },
];
const schema = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base
  title="Wedding florist Manchester — bridal bouquets & wedding flowers"
  description="Wedding flowers designed around you by Manchester florist Fia Florals: bridal bouquets, buttonholes, table and ceremony flowers. Check your date online."
  image={buttonholes}
  schema={schema}
>
  <section class="wrap page-hero">
    <nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Weddings</span></nav>
    <div class="split">
      <div class="stack">
        <span class="eyebrow">Wedding flowers</span>
        <h1 class="disp h1" style="font-size:clamp(46px,6vw,88px)">Your day, in flowers that <em>feel like you.</em></h1>
        <p class="lead">Bridal bouquets, buttonholes, table flowers and ceremony pieces, designed around your colours and your venue. My diary is open for weddings all year round.</p>

        <form class="checker" id="date-checker" data-booked={JSON.stringify(bookedWeddingDates)}>
          <div class="field" style="flex:1 1 220px">
            <label for="wdate">Check your wedding date</label>
            <input id="wdate" name="date" type="date" class="input" required />
          </div>
          <button type="submit" class="btn btn-primary">Check availability</button>
          <p class="result" role="status" aria-live="polite" hidden></p>
        </form>
      </div>
      <div class="arch-down" style="aspect-ratio:4/4.6"><Image src={buttonholes} alt="Wedding buttonholes of white roses, wax flower and eucalyptus, labelled for the groom's party" widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 560px" class="cover" loading="eager" /></div>
    </div>
  </section>

  <section class="white section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="disp h2" style="max-width:640px">Something a little bit <em>different.</em></h2>
        <p class="lead">No two of my bouquets are ever the same — yours will be designed for you, not picked from a catalogue.</p>
      </div>
      <div class="grid-3">
        <div class="rounded tall"><Image src={peony} alt="Peony, gerbera and sea lavender bouquet" widths={[400, 640]} sizes="(max-width:700px) 100vw, 400px" class="cover" /></div>
        <div class="rounded tall"><Image src={cream} alt="Calla lily, hydrangea and amaranthus bouquet" widths={[400, 640]} sizes="(max-width:700px) 100vw, 400px" class="cover" /></div>
        <div class="rounded tall"><Image src={wild} alt="Wild garden-style bouquet with sweet peas" widths={[400, 640]} sizes="(max-width:700px) 100vw, 400px" class="cover" /></div>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <ol class="steps">
      <li style="background:var(--sage)"><span class="n disp">1</span><h3>Check your date</h3><p>Use the date checker, then send me your details.</p></li>
      <li style="background:var(--coral)"><span class="n disp">2</span><h3>Talk it through</h3><p>Your colours, venue, style and the pieces you need.</p></li>
      <li style="background:var(--mint)"><span class="n disp">3</span><h3>Your proposal</h3><p>I put together your flower plan and quote.</p></li>
      <li style="background:var(--blush)"><span class="n disp">4</span><h3>The day</h3><p>Everything made fresh and ready for your wedding.</p></li>
    </ol>
  </section>

  <section class="wrap" id="enquire" style="padding-bottom:var(--section)">
    <div class="enq tint">
      <div class="stack" style="gap:14px">
        <span class="eyebrow">Wedding enquiry</span>
        <h2 class="disp h2" style="font-size:clamp(34px,3.6vw,50px)">Tell me about your day.</h2>
        <p class="body">The more you can share, the better — colours, a Pinterest board, your venue and roughly how many bouquets and buttonholes.</p>
      </div>
      <EnquiryForm
        id="wedding"
        subject="Wedding flowers enquiry"
        white
        submit="Send wedding enquiry"
        fields={[
          { name: 'wedding_date', label: 'Wedding date', type: 'date', required: true },
          { name: 'venue', label: 'Venue' },
          { name: 'guests', label: 'Number of guests', type: 'number' },
          { name: 'budget', label: 'Flower budget', placeholder: '£' },
          { name: 'colours', label: 'Colours and style', full: true },
          { name: 'message', label: 'Anything else', type: 'textarea' },
        ]}
      />
    </div>
  </section>

  <section class="wrap" style="padding-bottom:var(--section)">
    <h2 class="disp h2" style="font-size:clamp(30px,3vw,40px);margin-bottom:16px">Wedding questions</h2>
    <div class="faq">{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </section>
</Base>

<style>
  .checker { background: var(--white); border-radius: 24px; padding: 24px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; box-shadow: 0 20px 50px rgba(59, 33, 36, 0.08); }
  .result { flex-basis: 100%; border-radius: 14px; padding: 14px 16px; font-weight: 600; display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: space-between; }
  .result.ok { background: #e4ecd9; color: #2f4f2c; }
  .result.no { background: #f6dcd6; color: #7a2a1f; }
  .result :global(a) { color: inherit; }
  .tall { aspect-ratio: 4 / 5; }
  .enq { border-radius: 32px; padding: clamp(24px, 4vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 40px; align-items: start; }
</style>

<script>
  const form = document.getElementById('date-checker') as HTMLFormElement;
  const input = form.querySelector('input')!;
  const out = form.querySelector<HTMLElement>('.result')!;
  const booked: string[] = JSON.parse(form.dataset.booked || '[]');
  const enquiryDate = document.getElementById('wedding-wedding_date') as HTMLInputElement | null;

  const check = (value: string) => {
    if (!value) return;
    const d = new Date(value + 'T12:00:00');
    const nice = d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    const today = new Date().toISOString().slice(0, 10);
    out.hidden = false;
    if (value < today) {
      out.className = 'result no';
      out.textContent = 'That date has already passed — pick a future date.';
    } else if (booked.includes(value)) {
      out.className = 'result no';
      out.innerHTML = `<span>${nice} is already booked.</span><a href="#enquire">Ask about a nearby date →</a>`;
    } else {
      out.className = 'result ok';
      out.innerHTML = `<span>Good news — ${nice} is available.</span><a href="#enquire">Send your enquiry →</a>`;
      if (enquiryDate) enquiryDate.value = value;
    }
  };

  form.addEventListener('submit', (e) => { e.preventDefault(); check(input.value); });
  // Arriving from the homepage checker: /weddings?date=YYYY-MM-DD
  const pre = new URLSearchParams(location.search).get('date');
  if (pre && /^\d{4}-\d{2}-\d{2}$/.test(pre)) { input.value = pre; check(pre); }
</script>
