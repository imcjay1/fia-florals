---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
import Gallery from '../../components/Gallery.astro';
import { pick } from '../../data/gallery';
---
<Base
  title="Shop flowers online — bouquets, vases & subscriptions | Manchester"
  description="Order bespoke bouquets, vase arrangements, flower subscriptions and gift vouchers from Fia Florals, Manchester. Delivery or collection, secure Stripe checkout."
>
  <section class="wrap page-hero">
    <nav aria-label="Breadcrumb" class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Shop</span></nav>
    <div class="section-head">
      <div class="stack" style="gap:14px;max-width:700px">
        <span class="eyebrow">Order online</span>
        <h1 class="disp h2" style="font-size:clamp(44px,5.6vw,80px)">Pick a style. <em>I'll do the rest.</em></h1>
      </div>
      <p class="lead">Every order is designed and hand-tied by me. Choose your size and colours, then add delivery or collection, your date and a card message at checkout.</p>
    </div>
    <div class="grid-3 shop-grid">
      {products.map((p, i) => <ProductCard product={p} variant={p.kind === 'subscription' ? 'dark' : 'white'} />)}
    </div>
    <div class="custom tint">
      <div class="stack" style="gap:10px">
        <h2 class="disp" style="font-size:clamp(28px,3vw,36px)">Looking for something bigger?</h2>
        <p class="body">Weddings, funerals, events and business flowers are designed around you — send me the details.</p>
      </div>
      <div class="row">
        <a href="/weddings" class="btn btn-ghost btn-sm">Weddings</a>
        <a href="/funeral-flowers" class="btn btn-ghost btn-sm">Funeral flowers</a>
        <a href="/events-business" class="btn btn-ghost btn-sm">Events &amp; business</a>
        <a href="/unique-florals" class="btn btn-ghost btn-sm">Unique florals</a>
      </div>
    </div>
  </section>

  <section class="white section">
    <div class="wrap stack" style="gap:32px">
      <div class="section-head">
        <h2 class="disp h2" style="max-width:600px">How your bouquet <em>arrives.</em></h2>
        <p class="lead">No plain cellophane here. Every bouquet is wrapped in layers of paper picked to suit the flowers, then stood in a box or bag so it's ready to give.</p>
      </div>
      <div class="tiles">
        <div class="tile" style="background:var(--blush)"><h3>Layered paper</h3><p>Kraft over blush, olive, lilac, mauve or ivory, or hot pink for a big red rose bouquet.</p></div>
        <div class="tile" style="background:var(--sage)"><h3>Box or bag</h3><p>A Fia Florals box in dusty pink, sage or kraft, or a gift bag with rope handles, so it stands up on its own.</p></div>
        <div class="tile" style="background:var(--coral)"><h3>Finished by hand</h3><p>A round Fia Florals sticker and, in winter, a hessian collar tied with twine.</p></div>
        <div class="tile" style="background:var(--mint)"><h3>Cards included</h3><p>A card for your message, and a card on caring for your flowers so they last.</p></div>
      </div>
      <Gallery photos={pick('bqDelphiniumBox', 'bqWhiteBox', 'bqLilacSageBox', 'bqRedRosesCloseup', 'bqHydrangeaBag', 'bqAlliumsKraft', 'bqMauveWrap', 'winterCareCard', 'bqAmaranthusGreen')} />
      <div class="row"><a class="btn btn-primary" href="/shop/hand-tied-bouquet">Order a bouquet</a><a class="btn btn-ghost" href="/christmas-wreaths#winter">Winter bouquets</a><a class="btn btn-ghost" href="/gallery">Full gallery</a></div>
    </div>
  </section>
</Base>
<style>
  .shop-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .custom { margin-top: 56px; border-radius: 32px; padding: clamp(24px, 4vw, 44px); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; }
</style>
