---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import WorkshopCard from '../components/WorkshopCard.astro';
import Reviews from '../components/Reviews.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { products } from '../data/products';
import { workshops, businessQuote, privateWorkshopPhoto } from '../data/content';
import { business } from '../data/site';

import heroMain from '../assets/photos/sophia-bouquet-cream.jpg';
import heroSmall from '../assets/photos/orchid-vase.jpg';
import imgBouquets from '../assets/photos/two-bouquets.jpg';
import imgWeddings from '../assets/photos/wedding-buttonholes.jpg';
import imgWorkshops from '../assets/photos/pumpkin-workshop.jpg';
import imgFunerals from '../assets/photos/funeral-meadow.jpg';
import imgSubs from '../assets/photos/sophia-dahlia.jpg';
import imgBusiness from '../assets/photos/wild-bouquet.jpg';
import imgSophia from '../assets/photos/sophia-peony.jpg';
import imgHardy from '../assets/photos/hardy-bouquet.jpg';

const shop = ['hand-tied-bouquet', 'vase-arrangement', 'flower-subscription'].map((s) => products.find((p) => p.slug === s)!);
const services = [
  { title: 'Bouquets', go: 'Shop', href: '/shop', img: imgBouquets, alt: 'Two pink hydrangea bouquets wrapped in blush and kraft paper', text: 'Hand-tied for birthdays, baby showers, thank-yous and just because.' },
  { title: 'Weddings', go: 'Check dates', href: '/weddings', img: imgWeddings, alt: 'Tray of white rose buttonholes labelled for the groomsmen', text: 'Bridal bouquets, buttonholes and venue flowers. Diary open all year round.' },
  { title: 'Workshops', go: 'Book', href: '/workshops', img: imgWorkshops, alt: 'Workshop guests with the pumpkin floral centrepieces they made', text: 'Make it yourself, drink in hand. Public dates or your own private party.' },
  { title: 'Funeral flowers', go: 'Enquire', href: '/funeral-flowers', img: imgFunerals, alt: 'Meadow-style funeral tribute with dahlias and blue thistle', text: "Thoughtful tributes that reflect the person you're remembering." },
  { title: 'Subscriptions', go: 'Start', href: '/shop/flower-subscription', img: imgSubs, alt: 'Sophia with a dahlia and purple hydrangea bouquet', text: 'Seasonal flowers on repeat — weekly, fortnightly or monthly.' },
  { title: 'Events & business', go: 'Enquire', href: '/events-business', img: imgBusiness, alt: 'Sophia holding a wild, garden-style bouquet against a brick wall', text: 'Showroom, office and event flowers, refreshed as often as you like.' },
];
---
<Base
  title="Fia Florals — bespoke florist in Manchester | Bouquets, weddings & workshops"
  description="No boring flowers here. Bespoke bouquets, wedding and funeral flowers, flower subscriptions and floristry workshops, handmade by Sophia in Manchester."
>
  <!-- Hero -->
  <section class="wrap hero">
    <div class="stack">
      <span class="chip"><i></i>Manchester florist · Flowers &amp; more</span>
      <h1 class="disp h1">No <em>boring</em><br />flowers here.</h1>
      <p class="lead" style="max-width:520px">Bespoke bouquets, wedding and funeral flowers, and floristry workshops. Every bunch designed from scratch and handmade by Sophia.</p>
      <div class="row">
        <a class="btn btn-primary" href="/shop">Shop bouquets
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="btn btn-ghost" href="/workshops">Book a workshop</a>
      </div>
      <ul class="proof">
        <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></svg>Delivery or collection</li>
        <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6 0-9-5-12M12 21c0-6 0-9 5-12M12 13V5" /><circle cx="12" cy="4" r="2" /></svg>Hand-tied to order</li>
        <li><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>Workshops nationwide</li>
      </ul>
    </div>
    <div class="hero-art">
      <div class="arch big">
        <Image src={heroMain} alt="Sophia holding a large hand-tied bouquet of pink calla lilies, hydrangea and amaranthus" widths={[480, 720, 960]} sizes="(max-width: 900px) 80vw, 480px" class="cover" loading="eager" fetchpriority="high" />
      </div>
      <div class="round small">
        <Image src={heroSmall} alt="Pink orchid and anthurium arrangement in a green glass vase" widths={[300, 480]} sizes="220px" class="cover" loading="eager" />
      </div>
      <div class="badge">
        <svg class="ring" role="img" aria-label="Handmade in Manchester" width="150" height="150" viewBox="0 0 150 150"><defs><path id="ring-path" d="M75,75 m-56,0 a56,56 0 1,1 112,0 a56,56 0 1,1 -112,0" /></defs><text font-family="Figtree Variable, sans-serif" font-size="12.5" font-weight="600" letter-spacing="3.2" fill="#3B2124"><textPath href="#ring-path">HANDMADE IN MANCHESTER · FLOWERS &amp; MORE ·</textPath></text></svg>
        <svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40"><g fill="#8E3F33"><circle cx="20" cy="11" r="6" /><circle cx="29" cy="18" r="6" /><circle cx="25.5" cy="28" r="6" /><circle cx="14.5" cy="28" r="6" /><circle cx="11" cy="18" r="6" /></g><circle cx="20" cy="20" r="4.5" fill="#F2C9C2" /></svg>
      </div>
    </div>
  </section>

  <div class="ticker" aria-label="What I do">
    <span class="disp">Bouquets</span><span aria-hidden="true">✿</span>
    <span class="disp">Weddings</span><span aria-hidden="true">✿</span>
    <span class="disp">Funerals</span><span aria-hidden="true">✿</span>
    <span class="disp">Events</span><span aria-hidden="true">✿</span>
    <span class="disp">Workshops</span><span aria-hidden="true">✿</span>
    <span class="disp">Subscriptions</span>
  </div>

  <!-- Services -->
  <section class="wrap section">
    <div class="section-head">
      <h2 class="disp h2" style="max-width:680px">Whatever the moment, <em>made for it.</em></h2>
      <p class="lead">Soft romantic pastels, bold and bright, or something completely unique — tell me the moment and I'll design the flowers.</p>
    </div>
    <div class="grid-3">
      {services.map((s) => (
        <a class="svc" href={s.href}>
          <div class="media rounded"><Image src={s.img} alt={s.alt} widths={[400, 640, 900]} sizes="(max-width: 700px) 100vw, 400px" class="cover" /></div>
          <div class="top"><h3 class="disp h3">{s.title}</h3><span class="go">{s.go} →</span></div>
          <p class="body">{s.text}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Shop -->
  <section class="tint section" id="shop">
    <div class="wrap">
      <div class="section-head">
        <div class="stack" style="gap:14px;max-width:640px">
          <span class="eyebrow">Order online</span>
          <h2 class="disp h2">Pick a style. <em>I'll do the rest.</em></h2>
        </div>
        <p class="lead">Choose your size and colours, then add delivery or collection, your date and a card message at secure checkout.</p>
      </div>
      <div class="grid-3">
        <ProductCard product={shop[0]} />
        <ProductCard product={shop[1]} />
        <ProductCard product={shop[2]} variant="dark" />
      </div>
      <p class="secure"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>Secure checkout with Stripe · Card, Apple Pay &amp; Google Pay · <a href="/shop/gift-voucher">Gift vouchers</a></p>
    </div>
  </section>

  <!-- Workshops -->
  <section class="wrap section" id="workshops">
    <div class="split" style="align-items:start">
      <div class="stack sticky">
        <span class="eyebrow">Floristry workshops</span>
        <h2 class="disp h2">Come and make <em>something.</em></h2>
        <p class="lead">Relaxed, hands-on evenings with a drink on arrival and the best seasonal flowers. No experience needed — I'll guide you through every step and you'll take home something you made yourself.</p>
        <div class="pills">
          <span class="pill sage">Christmas wreaths</span><span class="pill coral">Pumpkin florals</span><span class="pill mint">Summer bouquets</span><span class="pill">Hen parties</span><span class="pill">Team socials</span>
        </div>
        <p class="small">Hosted at Hatters Food Hall, Denton — next up, 3SIXTY, Newcastle.</p>
      </div>
      <div class="stack" data-empty-when-none="[data-workshop]">
        {workshops.map((w) => <WorkshopCard w={w} />)}
        <article class="private dark" id="private">
          <div class="info">
            <span class="eyebrow">Private workshops</span>
            <h3 class="disp h3">Your people, your place.</h3>
            <p class="body">At your home, your workplace or on a girls' weekend away. Tell me the date and how many of you, and I'll bring everything.</p>
            <a class="btn btn-cream btn-sm" href="/workshops#private-form">Plan a private workshop</a>
          </div>
          <div class="pmedia"><Image src={privateWorkshopPhoto.src} alt={privateWorkshopPhoto.alt} widths={[480, 800]} sizes="(max-width: 700px) 100vw, 360px" class="cover" /></div>
        </article>
      </div>
    </div>
  </section>

  <!-- Weddings -->
  <section class="white section" id="weddings">
    <div class="wrap split">
      <div class="arch-down" style="aspect-ratio:4/4.6"><Image src={imgWeddings} alt="Wedding buttonholes of white roses, wax flower and eucalyptus labelled for the groom's party" widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 560px" class="cover" /></div>
      <div class="stack">
        <span class="eyebrow">Wedding flowers</span>
        <h2 class="disp h2">Your day, in flowers that <em>feel like you.</em></h2>
        <p class="lead">Bridal bouquets, buttonholes, table flowers and ceremony pieces, designed around your colours and your venue. My diary is open for weddings all year round.</p>
        <form class="checker" action="/weddings" method="get">
          <div class="field" style="flex:1 1 220px">
            <label for="home-wdate">Your wedding date</label>
            <input id="home-wdate" name="date" type="date" class="input" required />
          </div>
          <button type="submit" class="btn btn-primary">Check availability</button>
        </form>
      </div>
    </div>
  </section>

  <!-- Funerals -->
  <section class="dark" id="funerals">
    <div class="wrap split funerals">
      <div class="stack" style="padding-block:var(--section)">
        <span class="eyebrow">Funeral flowers</span>
        <h2 class="disp h2" style="font-size:clamp(36px,4.2vw,58px)">Made with care, for the person you're remembering.</h2>
        <p class="lead">Sheaves, wreaths, posies and personal tributes — in their favourite colours, or a style that says something about them. If it's easier to talk it through, just call.</p>
        <div class="row">
          <a class="btn btn-cream" href={`tel:${business.phoneIntl}`}>Call Sophia — {business.phone}</a>
          <a class="btn btn-outline-light" href="/funeral-flowers#enquire">Send an enquiry</a>
        </div>
      </div>
      <div class="fmedia"><Image src={imgFunerals} alt="Close detail of a meadow-style funeral tribute with pink dahlia and blue thistle" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 600px" class="cover" /></div>
    </div>
  </section>

  <!-- Subscriptions -->
  <section class="wrap section" id="subscriptions">
    <div class="stack center" style="margin-bottom:56px">
      <span class="eyebrow">Flower subscriptions</span>
      <h2 class="disp h2">Fresh flowers, <em>on repeat.</em></h2>
      <p class="lead" style="max-width:620px">Brighten your home or elevate a workspace with seasonal blooms in rotation — set it up once and I handle the rest.</p>
    </div>
    <ol class="steps">
      <li style="background:var(--sage)"><span class="n disp">1</span><h3>Choose your style</h3><p>A hand-tied bouquet, or a vase arrangement with the vase swapped at every delivery.</p></li>
      <li style="background:var(--coral)"><span class="n disp">2</span><h3>Pick your size</h3><p>From a cheerful kitchen-table bunch to a proper statement piece.</p></li>
      <li style="background:var(--mint)"><span class="n disp">3</span><h3>Set your frequency</h3><p>Weekly, fortnightly or monthly. Billed automatically, so you never have to think about it.</p></li>
      <li style="background:var(--blush)"><span class="n disp">4</span><h3>Delivery or collection</h3><p>Straight to your door, or ready to collect when it suits you.</p></li>
    </ol>
    <div class="row" style="justify-content:center;margin-top:40px"><a class="btn btn-primary" href="/shop/flower-subscription">Start a subscription</a></div>
  </section>

  <!-- Business -->
  <section class="wrap" style="padding-bottom:var(--section)">
    <div class="biz tint">
      <div class="stack" style="gap:14px">
        <span class="eyebrow">Flowers for business</span>
        <h2 class="disp" style="font-size:clamp(30px,3.2vw,40px);line-height:1.1">Showrooms, offices, receptions and client gifts.</h2>
        <a class="link-arrow" href="/events-business">Talk to me about weekly flowers →</a>
      </div>
      <figure class="bq">
        <blockquote class="disp">“{businessQuote.quote}”</blockquote>
        <figcaption>{businessQuote.name} — {businessQuote.context}</figcaption>
      </figure>
    </div>
  </section>

  <!-- About -->
  <section class="white section" id="about">
    <div class="wrap split">
      <div class="about-art">
        <div class="arch"><Image src={imgSophia} alt="Sophia, owner of Fia Florals, smiling over a peony bouquet" widths={[480, 720, 960]} sizes="(max-width: 900px) 80vw, 460px" class="cover" style="object-position:50% 15%" /></div>
        <figure class="hardy">
          <div class="round"><Image src={imgHardy} alt="Hardy the black and white cat stretched out beside a bouquet" widths={[300, 480]} sizes="240px" class="cover" style="object-position:85% 100%" /></div>
          <figcaption class="disp">Hardy, the most important team member</figcaption>
        </figure>
      </div>
      <div class="stack">
        <span class="eyebrow">Hello, I'm Sophia</span>
        <h2 class="disp h2">I like to create flowers that are <em>unique.</em></h2>
        <p class="lead">Fia Florals is my Manchester flower business — bouquets, weddings, funerals, events, and the workshops I love hosting. Every bunch is designed from scratch, so no two are ever the same.</p>
        <p class="lead">Every bouquet is an honour to make, whether it's for a birthday, a new baby or a goodbye. And yes, that's Hardy — the most important member of the team.</p>
        <a class="link-arrow" href="/about">More about me →</a>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- Enquire -->
  <section class="wrap" id="enquire" style="padding-bottom:var(--section)">
    <div class="enquire">
      <div class="stack" style="gap:18px">
        <h2 class="disp h2">Let's make something <em style="color:var(--plum)">beautiful.</em></h2>
        <p class="lead" style="color:var(--plum)">Tell me what you're planning and when, and I'll come back to you with ideas.</p>
        <div class="contact">
          <a href={`tel:${business.phoneIntl}`}>{business.phone}</a>
          <a href={`mailto:${business.email}`}>{business.email}</a>
          <a href={business.whatsapp}>Message on WhatsApp</a>
        </div>
      </div>
      <EnquiryForm
        id="home-enquiry"
        subject="Website enquiry"
        fields={[
          { name: 'looking_for', label: "I'm looking for", type: 'select', options: ['Bouquet', 'Wedding flowers', 'Funeral flowers', 'Event flowers', 'Private workshop', 'Business flowers', 'Something else'] },
          { name: 'date', label: 'Date needed', type: 'date' },
          { name: 'message', label: 'Tell me more', type: 'textarea', required: true },
        ]}
      />
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 56px; align-items: center; padding-block: 36px 96px; }
  .proof { list-style: none; margin: 0; padding: 10px 0 0; display: flex; flex-wrap: wrap; gap: 14px 28px; font-size: 15px; color: var(--text); }
  .proof li { display: flex; gap: 10px; align-items: center; }
  .proof svg { color: var(--brick); }
  .hero-art { position: relative; min-height: clamp(460px, 52vw, 620px); }
  .hero-art .big { position: absolute; right: 0; top: 0; width: 78%; height: 96%; }
  .hero-art .small { position: absolute; left: 0; bottom: 0; width: 42%; aspect-ratio: 1; border: 8px solid var(--petal); box-shadow: 0 24px 60px rgba(59, 33, 36, 0.18); }
  .hero-art .badge { position: absolute; left: 4%; top: 30px; }
  @media (max-width: 560px) { .hero-art .badge { width: 110px; height: 110px; } .hero-art .badge .ring { width: 110px; height: 110px; } }
  .secure { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; align-items: center; font-size: 14px; color: var(--text); }
  .sticky { position: sticky; top: 24px; }
  @media (max-width: 900px) { .sticky { position: static; } }
  .private { border-radius: 28px; overflow: hidden; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .private .info { padding: 30px; display: flex; flex-direction: column; gap: 14px; justify-content: center; }
  .private .btn { align-self: flex-start; }
  .pmedia { min-height: 280px; }
  .checker { background: var(--petal); border-radius: 24px; padding: 26px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
  .fmedia { align-self: stretch; min-height: 420px; margin-inline: calc(var(--gutter) * -1) 0; }
  @media (min-width: 1000px) { .fmedia { margin-right: calc((100vw - min(100vw, var(--wrap))) / -2 - var(--gutter)); } }
  .funerals { gap: 0 56px; }
  .biz { border-radius: 32px; padding: clamp(28px, 4vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 40px; align-items: center; }
  .bq { margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .bq blockquote { margin: 0; font-size: clamp(21px, 2vw, 26px); line-height: 1.35; font-style: italic; }
  .bq figcaption { font-size: 15px; font-weight: 600; color: var(--text); }
  .about-art { position: relative; min-height: clamp(480px, 50vw, 600px); }
  .about-art .arch { position: absolute; left: 0; top: 0; width: 80%; height: 92%; }
  .hardy { position: absolute; right: 0; bottom: 0; width: 46%; margin: 0; display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .hardy .round { width: 100%; aspect-ratio: 1; border: 8px solid var(--white); box-shadow: 0 24px 60px rgba(59, 33, 36, 0.16); }
  .hardy figcaption { font-size: 17px; font-style: italic; color: var(--text); text-align: center; background: var(--white); border-radius: 999px; padding: 4px 14px; }
  @media (max-width: 600px) { .about-art { min-height: 520px; } .about-art .arch { height: 80%; } .hardy { width: 52%; } .hardy figcaption { font-size: 14px; } }
  .enquire { background: var(--rose); border-radius: 36px; padding: clamp(28px, 5vw, 64px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 44px; align-items: start; }
  .contact { display: flex; flex-direction: column; gap: 10px; font-weight: 600; }
  .contact a { color: var(--plum); }
</style>
